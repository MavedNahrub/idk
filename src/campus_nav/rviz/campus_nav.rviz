Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Road Network1
        - /Campus Stops1
        - /saye Buggy (Live 3D Model)1
        - /RealSense Camera Feed1
      Splitter Ratio: 0.550000011920929
    Tree Height: 349
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.30000001192092896
      Cell Size: 50
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.05000000074505806
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 600
        Y: 800
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Road Network
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/road_graph
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Junctions
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/junction_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Campus Stops
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/stop_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Buildings
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/building_markers
      Value: true
    - Alpha: 0.8999999761581421
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 255; 255
      Enabled: true
      Head Diameter: 1
      Head Length: 0.20000000298023224
      Length: 1
      Line Style: Lines
      Line Width: 0.10000000149011612
      Name: Global Path (Centerline)
      Offset:
        X: 0
        Y: 0
        Z: 0.3499999940395355
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.4000000059604645
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/global_path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Active Route (Solid 3.8m Road Carpet)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/route_ribbon
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Route Centerline (White)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/route_centerline
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: saye Buggy (Live 3D Model)
      Namespaces:
        buggy: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/vehicle_marker
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Safety Corridor (Dynamic Bounds)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/safety_corridor
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: "Detected Threats & Obstacles"
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /campus/safety_threats
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RealSense Camera Feed
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /real_sense/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 33; 39
    Fixed Frame: map
    Frame Rate: 120
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 32
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.10000000149011612
      Pitch: 0.6499999761581421
      Target Frame: nav_base_link
      Value: ThirdPersonFollower (rviz_default_plugins)
      Yaw: 1.5707999467849731
    Saved:
      - Class: rviz_default_plugins/ThirdPersonFollower
        Distance: 32
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.05999999865889549
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 1
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05000000074505806
        Invert Z Axis: false
        Name: Third Person Buggy View
        Near Clip Distance: 0.10000000149011612
        Pitch: 0.6499999761581421
        Target Frame: nav_base_link
        Value: ThirdPersonFollower (rviz_default_plugins)
        Yaw: 1.5707999467849731
      - Class: rviz_default_plugins/Orbit
        Distance: 45
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.05999999865889549
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 1
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05000000074505806
        Invert Z Axis: false
        Name: Orbit Buggy Follower
        Near Clip Distance: 0.10000000149011612
        Pitch: 0.6499999761581421
        Target Frame: nav_base_link
        Value: Orbit (rviz_default_plugins)
        Yaw: 1.5707999467849731
      - Class: rviz_default_plugins/Orbit
